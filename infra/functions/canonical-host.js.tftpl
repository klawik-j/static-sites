var CANONICAL_HOST = "${canonical_host}";

function handler(event) {
    var request = event.request;
    var host = request.headers.host && request.headers.host.value;

    if (!host || host === CANONICAL_HOST) {
        return request;
    }

    // CloudFront hands the query string back as an object, so it has to be rebuilt by hand.
    var query = "";
    for (var name in request.querystring) {
        var parameter = request.querystring[name];
        var values = parameter.multiValue || [parameter];

        for (var i = 0; i < values.length; i++) {
            query += query ? "&" : "?";
            query += name + (values[i].value === "" ? "" : "=" + values[i].value);
        }
    }

    return {
        statusCode: 301,
        statusDescription: "Moved Permanently",
        headers: {
            location: { value: "https://" + CANONICAL_HOST + request.uri + query },
            "cache-control": { value: "max-age=3600" }
        }
    };
}
